---
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import SocialPill from "../components/SocialPill.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import MailIcon from "../components/icons/Mail.astro";
---

<Layout
  title="Portfolio | Matias Salinas - Backend Developer"
  description="Portafolio de Matias Salinas - Desarrollador Backend y estudiante avanzado de Ingeniería en Sistemas de Información."
>
  <main class="space-y-24 sm:space-y-32 pb-24 sm:pb-32">
    {/* HERO SECTION */}
    <SectionContainer id="top" class="pt-36 sm:pt-48 md:pt-56">
      <div class="flex flex-col items-start gap-8 max-w-3xl">
        {/* Availability Badge */}
        <a
          href="https://linkedin.com/in/salinasmatias1/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block transition-transform hover:scale-[1.02] active:scale-[0.98]"
          data-reveal
        >
          <Badge>Disponible para trabajar</Badge>
        </a>

        {/* Editorial Heading */}
        <div class="space-y-6" data-reveal>
          <h1
            class="text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter text-fg leading-[1.02] text-balance"
          >
            Hola, soy Matías<span class="text-accent">.</span>
          </h1>

          <p class="text-xl sm:text-2xl text-muted font-normal leading-snug max-w-2xl text-pretty">
            Estudiante avanzado de <span class="text-fg">Ingeniería en Sistemas de Información</span>.
            Especializado en desarrollo <span class="text-fg">Backend</span>.
          </p>
        </div>

        {/* Focus Statement */}
        <p class="text-base sm:text-lg text-subtle leading-relaxed max-w-xl text-pretty" data-reveal>
          Me dedico a diseñar la lógica y arquitectura interna de las aplicaciones web.
        </p>

        {/* Social Actions */}
        <nav class="flex items-center gap-3 flex-wrap" aria-label="Enlaces sociales" data-reveal>
          <a
            href="mailto:matisalinas.2000@gmail.com"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-fg text-bg text-sm font-medium hover:opacity-85 transition-opacity duration-200 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
          >
            <MailIcon class="size-4" />
            <span>Contactar</span>
          </a>

          <SocialPill href="https://linkedin.com/in/salinasmatias1/">
            <LinkedInIcon class="size-4 text-subtle" />
            <span>LinkedIn</span>
          </SocialPill>

          <SocialPill href="https://github.com/matisalinas7">
            <GitHubIcon class="size-4 text-subtle" />
            <span>GitHub</span>
          </SocialPill>
        </nav>
      </div>
    </SectionContainer>

    {/* PROYECTOS SECTION */}
    <SectionContainer
      id="proyectos"
      title="Proyectos"
      subtitle="Arquitectura de software, APIs RESTful y sistemas en producción"
    >
      <Projects />
    </SectionContainer>

    {/* FORMACIÓN ACADÉMICA SECTION */}
    <SectionContainer
      id="experiencia"
      title="Formación Académica"
      subtitle="Bases formales en ingeniería de software y aprendizaje continuo"
    >
      <Experience />
    </SectionContainer>

    {/* SOBRE MÍ SECTION */}
    <SectionContainer
      id="sobre-mi"
      title="Sobre mí"
      subtitle="Perfil profesional, filosofía técnica y enfoque de desarrollo"
    >
      <div class="space-y-6 text-lg sm:text-xl leading-relaxed text-muted max-w-2xl text-pretty" data-reveal>
        <p>
          ¡Hola! Me llamo <strong class="font-medium text-fg">Matías</strong> y soy <strong class="font-medium text-fg">estudiante avanzado de Ingenieria en Sistemas de Información</strong>.
        </p>

        <p>
          Cuento con experiencia académica creando aplicaciones web completas, pero mi enfoque es el <strong class="font-medium text-fg">Backend</strong>. Disfruto diseñando <strong class="font-medium text-fg">Bases de Datos</strong> eficientes, lógica de negocio compleja y <strong class="font-medium text-fg">APIs REST</strong> seguras utilizando tecnologías como <strong class="font-medium text-fg">Java</strong> y <strong class="font-medium text-fg">Spring Boot</strong>.
        </p>
      </div>
    </SectionContainer>

    {/* CONTACTO SECTION */}
    <SectionContainer id="contacto">
      <div class="border-t border-line pt-16 sm:pt-24 flex flex-col items-start gap-8" data-reveal>
        <div class="space-y-5 max-w-2xl">
          <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-fg leading-[1.05] text-balance">
            ¿Listo para trabajar juntos?
          </h2>
          <p class="text-lg sm:text-xl text-muted leading-relaxed text-pretty">
            Estoy buscando nuevas oportunidades para aportar mi visión en el desarrollo Backend. Si tienes un proyecto en mente o quieres potenciar tu equipo, hablemos.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center w-full sm:w-auto">
          <a
            href="mailto:matisalinas.2000@gmail.com"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium rounded-full bg-fg text-bg hover:opacity-85 transition-opacity duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
          >
            <MailIcon class="size-4" />
            <span>Enviar correo</span>
          </a>

          <button
            id="btn-copy"
            type="button"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium rounded-full border border-line text-muted hover:border-fg/40 hover:text-fg transition-colors duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
          >
            <svg
              id="icon-copy"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path
                d="M8 8m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z"
              ></path>
              <path
                d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2"
              ></path>
            </svg>

            <svg
              id="icon-check"
              class="hidden size-4 text-accent"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M5 12l5 5l10 -10"></path>
            </svg>

            <span id="text-copy">Copiar email</span>
          </button>
        </div>
      </div>
    </SectionContainer>

    {/* Clipboard copy script */}
    <script>
      const btnCopy = document.getElementById("btn-copy");
      const iconCopy = document.getElementById("icon-copy");
      const iconCheck = document.getElementById("icon-check");
      const textCopy = document.getElementById("text-copy");
      const email = "matisalinas.2000@gmail.com";

      if (btnCopy) {
        btnCopy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(email);
            if (iconCopy) iconCopy.classList.add("hidden");
            if (iconCheck) iconCheck.classList.remove("hidden");
            if (textCopy) textCopy.innerText = "¡Copiado!";

            setTimeout(() => {
              if (iconCopy) iconCopy.classList.remove("hidden");
              if (iconCheck) iconCheck.classList.add("hidden");
              if (textCopy) textCopy.innerText = "Copiar email";
            }, 2200);
          } catch (_) {}
        });
      }
    </script>
  </main>
</Layout>
