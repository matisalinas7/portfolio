---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/onest";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Prevent theme FOUC + marca que hay JS para las animaciones de entrada -->
    <script is:inline>
      (function() {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          const isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col bg-bg text-muted antialiased selection:bg-accent/30 selection:text-fg relative"
  >
    <!-- Brillo de fondo muy sutil -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-64 -left-32 w-[640px] h-[480px] rounded-full bg-accent/[0.07] blur-[120px]"
      >
      </div>
    </div>

    <Header />
    <slot />
    <Footer />

    <script>
      // Entrada suave al hacer scroll
      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        reveals.forEach((el) => io.observe(el));
      }

      // Enlace activo en la navegación según la sección visible
      const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
      // Incluye el hero (#top) para que en el inicio no quede ningún enlace marcado
      const sections = ["#top", ...Array.from(links).map((a) => a.getAttribute("href") || "")]
        .map((sel) => document.querySelector<HTMLElement>(sel))
        .filter((s): s is HTMLElement => !!s);

      const updateActive = () => {
        const line = window.innerHeight * 0.4;
        let current = "top";
        for (const s of sections) {
          if (s.getBoundingClientRect().top <= line) current = s.id;
        }
        links.forEach((a) =>
          a.toggleAttribute("data-active", a.getAttribute("href") === `#${current}`),
        );
      };

      updateActive();
      window.addEventListener("scroll", updateActive, { passive: true });
      window.addEventListener("resize", updateActive);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: 250 250 249;
    --surface: 244 244 242;
    --fg: 12 10 9;
    --muted: 87 83 78;
    --subtle: 135 129 123;
    --line: 229 227 224;
    --accent: 63 98 18;
  }

  :root.dark {
    color-scheme: dark;
    --bg: 10 10 11;
    --surface: 20 20 22;
    --fg: 244 244 245;
    --muted: 161 161 170;
    --subtle: 113 113 122;
    --line: 36 36 40;
    --accent: 190 242 100;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Animación de entrada: solo se oculta si hay JS para revelarla */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Scrollbar discreta */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgb(var(--subtle) / 0.35);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgb(var(--subtle) / 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
