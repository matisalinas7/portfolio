---
const EDUCATION = [
  {
    date: "En curso (Actualidad)",
    status: "En curso",
    title: "Ingeniería en Sistemas de Información",
    company: "Universidad Tecnológica Nacional (FRM)",
    description:
      "Adquisición de bases sólidas en Algoritmos y Estructuras de Datos, Paradigmas de Programación (POO), Diseño de Sistemas, Ingenieria de Software y Gestión de Bases de Datos Relacionales.",
    link: "https://www.frm.utn.edu.ar/",
  },
  {
    date: "Finalizado en Junio 2023",
    status: "Graduado",
    title: "Programación Web Full Stack",
    company: "Egg Cooperation",
    description:
      "Bootcamp intensivo de +500 horas teóricas y prácticas. con foco en Java, POO, Spring Boot y React.",
    certificate: "/certificado_curso.pdf",
  },
];
---

<div class="flex flex-col">
  {
    EDUCATION.map((experience) => (
      <div
        data-reveal
        class="py-8 first:pt-0 last:pb-0 border-b border-line last:border-b-0 grid gap-3 sm:gap-8 sm:grid-cols-[10rem_minmax(0,1fr)]"
      >
        <p class="text-xs font-mono text-subtle pt-1.5">{experience.date}</p>

        <div class="space-y-3 min-w-0">
          <div class="space-y-1">
            <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-fg text-balance">
              {experience.title}
            </h3>

            <p class="text-sm font-medium text-accent">
              {experience.link ? (
                <a
                  href={experience.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 hover:underline underline-offset-4"
                >
                  {experience.company}
                  <svg
                    class="size-3.5 inline-block opacity-70"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17l9.2-9.2M17 17V8H8" />
                  </svg>
                </a>
              ) : (
                experience.company
              )}
            </p>
          </div>

          <p class="text-[15px] sm:text-base text-muted leading-relaxed max-w-2xl text-pretty">
            {experience.description}
          </p>

          {experience.certificate && (
            <a
              href={experience.certificate}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-full border border-line text-muted hover:border-fg/40 hover:text-fg transition-colors duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
            >
              <svg
                class="size-4 text-subtle"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                />
              </svg>
              <span>Ver Certificado</span>
            </a>
          )}
        </div>
      </div>
    ))
  }
</div>
