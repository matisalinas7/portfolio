---
const EDUCATION = [
  {
    date: "En curso (Actualidad)",
    status: "En curso",
    title: "Ingeniería en Sistemas de Información",
    company: "Universidad Tecnológica Nacional (FRM)",
    description:
      "Adquisición de bases sólidas en Algoritmos y Estructuras de Datos, Paradigmas de Programación (POO), Diseño de Sistemas, Ingenieria de Software y Gestión de Bases de Datos Relacionales.",
    link: "https://www.frm.utn.edu.ar/",
  },
  {
    date: "Finalizado en Junio 2023",
    status: "Graduado",
    title: "Programación Web Full Stack",
    company: "Egg Cooperation",
    description:
      "Bootcamp intensivo de +500 horas teóricas y prácticas. con foco en Java, POO, Spring Boot y React.",
    certificate: "/certificado_curso.pdf",
  },
];
---

<div class="flex flex-col gap-6">
  {
    EDUCATION.map((experience) => (
      <div class="group relative rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/60 dark:bg-[#121215]/60 backdrop-blur-sm p-6 sm:p-7 transition-all duration-300 hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-lg hover:shadow-neutral-900/[0.02] dark:hover:shadow-black/40">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-3">
          <div>
            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
              <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/80 dark:bg-neutral-800/60 text-neutral-600 dark:text-neutral-400">
                {experience.date}
              </span>
            </div>
            
            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
              {experience.title}
            </h3>

            <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mt-0.5">
              {experience.link ? (
                <a
                  href={experience.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 hover:underline underline-offset-4"
                >
                  {experience.company}
                  <svg
                    class="size-3.5 inline-block opacity-70"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17l9.2-9.2M17 17V8H8" />
                  </svg>
                </a>
              ) : (
                experience.company
              )}
            </p>
          </div>

          {experience.certificate && (
            <div class="flex-shrink-0">
              <a
                href={experience.certificate}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200
                  border border-neutral-200 dark:border-neutral-700
                  text-neutral-700 dark:text-neutral-300
                  bg-neutral-50 dark:bg-neutral-900
                  hover:bg-neutral-100 dark:hover:bg-neutral-800
                  hover:text-neutral-950 dark:hover:text-white
                  active:scale-[0.98] shadow-sm"
              >
                <svg
                  class="size-3.5 text-neutral-500 dark:text-neutral-400"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
                <span>Ver Certificado</span>
              </a>
            </div>
          )}
        </div>

        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl text-pretty">
          {experience.description}
        </p>
      </div>
    ))
  }
</div>
