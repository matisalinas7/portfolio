---
// Con `title` dibuja la sección en dos columnas (título fijo a la izquierda,
// contenido a la derecha). Sin `title` es un bloque libre (hero, contacto).
const { class: className, id, title, subtitle } = Astro.props;
---

<section
  id={id}
  data-section={id}
  class:list={[
    "section scroll-mt-24 w-full mx-auto max-w-page px-5 sm:px-8",
    className,
  ]}
>
  {
    title ? (
      <div class="grid gap-8 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-12 border-t border-line pt-8 sm:pt-10">
        <div class="md:sticky md:top-24 md:self-start space-y-1.5" data-reveal>
          <h2 class="text-sm font-medium tracking-wide uppercase text-fg">{title}</h2>
          {subtitle && (
            <p class="text-sm text-subtle leading-relaxed text-pretty">{subtitle}</p>
          )}
        </div>
        <div class="min-w-0">
          <slot />
        </div>
      </div>
    ) : (
      <slot />
    )
  }
</section>
