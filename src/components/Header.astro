---
import ThemeToggle from "./ThemeToggle.astro";

const LINKS = [
  { href: "#proyectos", label: "Proyectos" },
  { href: "#experiencia", label: "Formación" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-line/70 bg-bg/70 backdrop-blur-xl"
>
  <div class="mx-auto max-w-page px-5 sm:px-8 h-14 flex items-center justify-between gap-4">
    <a
      href="#top"
      class="text-sm font-semibold tracking-tight text-fg hover:text-accent transition-colors"
      aria-label="Ir al inicio"
    >
      MS<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-3 min-w-0">
      <nav class="flex items-center gap-3 sm:gap-6" aria-label="Navegación principal">
        {
          LINKS.map(({ href, label }) => (
            <a
              href={href}
              data-nav-link
              class="relative py-1 text-[13px] sm:text-sm whitespace-nowrap text-subtle hover:text-fg data-[active]:text-fg transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 data-[active]:after:scale-x-100"
            >
              {label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>
