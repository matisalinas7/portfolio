---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Java from "./icons/Java.astro";
import MySQL from "./icons/MySQL.astro";
import Spring from "./icons/Spring.astro";
import Preview from "./icons/Preview.astro";
import LiveAPI from "./icons/LiveAPI.astro";
import AngularIcon from "./icons/Angular.astro";
import TypeScriptIcon from "./icons/Typescript.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: null,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: null,
  },
  JAVA: {
    name: "Java",
    class: "bg-[#b07219] text-white",
    icon: null,
  },
  SPRING: {
    name: "Spring Boot",
    class: "bg-[#6db33f] text-white",
    icon: null,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00758f] text-white",
    icon: null,
  },
  ARCHITECTURE: {
    name: "Software Architecture",
    class: "bg-gray-700 text-white",
    icon: null,
  },
  JPA: {
    name: "JPA / Hibernate",
    class: "bg-purple-800 text-white",
    icon: null,
  },
  JSF: {
    name: "Jakarta EE & JSF",
    class: "bg-red-800 text-white",
    icon: null,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#0db7ed] text-white",
    icon: null,
  },
  JWT: {
    name: "JWT",
    class: "bg-[#d63aff] text-white",
    icon: null,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-red-900 text-white",
    icon: null,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-blue-900 text-white",
    icon: null,
  },
};

const PROJECTS = [
  {
    title: "Wallet API - Billetera Virtual",
    description:
      "API RESTful para gestión de saldos y transferencias entre usuarios. Implementa autenticación stateless con JWT, encriptación de contraseñas con BCrypt, arquitectura en capas con DTOs, manejo global de excepciones y tests unitarios. Deployada en Railway con MySQL en la nube.",
    link: "https://wallet-api-ysax.onrender.com/swagger-ui/index.html",
    github: "https://github.com/matisalinas7/wallet-api",
    image: "/wallet-api.png",
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.MYSQL, TAGS.JPA, TAGS.DOCKER, TAGS.JWT],
  },
  {
    title: "Sistema de Reservas",
    description:
      "Aplicación full stack para gestión de reservas. Backend con Spring Boot 4 en arquitectura en capas con DTOs, validación de solapamiento de horarios y manejo global de excepciones. Frontend con Angular 21, Reactive Forms, signals y sistema de notificaciones toast.",
    link: "",
    github: "https://github.com/matisalinas7/reservation-app",
    image: "/reservas.png",
    tags: [
      TAGS.JAVA,
      TAGS.SPRING,
      TAGS.MYSQL,
      TAGS.JPA,
      TAGS.ANGULAR,
      TAGS.TYPESCRIPT,
    ],
  },
  {
    title: "API REST para Gestión Gastronómica",
    description:
      "Arquitectura RESTful escalable. Implementa seguridad avanzada (RBAC) con JWT, arquitectura en capas, patrones de diseño y estrategias de integridad de datos (Soft Delete). Simulación de entorno de producción real.",
    link: "",
    github: "https://github.com/matisalinas7/elbuensabor-backend",
    image: "/codigo-backend.png",
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.MYSQL, TAGS.JPA, TAGS.JWT],
  },
  {
    title: "Sistema Enterprise de Gestión de Trámites",
    description:
      "Aplicación corporativa desarrollada bajo un estricto enfoque de Desarrollo Dirigido por Modelos (MDD). Destaca por la fidelidad absoluta entre los Diagramas de Secuencia (Arquitectura) y la implementación del código Java.",
    link: "",
    github: "https://github.com/matisalinas7/gestionTramites",
    image: "/listaTramites.png",
    tags: [TAGS.JSF, TAGS.JAVA, TAGS.ARCHITECTURE, TAGS.MYSQL],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt="imagen del proyecto"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-white">{title}</h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-wrap mb-2 gap-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 items-center`}
                  >
                    {tag.icon && <tag.icon class="size-4" />}
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-300 text-pretty">{description}</div>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-3 py-2 text-base text-white transition bg-gray-800 border border-gray-600 rounded-xl hover:bg-gray-900 hover:border-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
                >
                  <GitHub class="size-6" />
                  Code
                </a>
              )}
              {link && (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-3 py-2 text-base text-white transition bg-gray-800 border border-gray-600 rounded-xl hover:bg-gray-900 hover:border-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
                >
                  <LiveAPI class="size-6" />
                  Live Api
                </a>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
