---
import GitHub from "./icons/GitHub.astro";
import LiveAPI from "./icons/LiveAPI.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
  },
  TAILWIND: {
    name: "Tailwind CSS",
  },
  JAVA: {
    name: "Java",
  },
  SPRING: {
    name: "Spring Boot",
  },
  MYSQL: {
    name: "MySQL",
  },
  ARCHITECTURE: {
    name: "Software Architecture",
  },
  JPA: {
    name: "JPA / Hibernate",
  },
  JSF: {
    name: "Jakarta EE & JSF",
  },
  DOCKER: {
    name: "Docker",
  },
  JWT: {
    name: "JWT",
  },
  ANGULAR: {
    name: "Angular",
  },
  TYPESCRIPT: {
    name: "TypeScript",
  },
  SWAGGER: {
    name: "Swagger",
  },
  FLYWAY: {
    name: "Flyway",
  },
  JUNIT: {
    name: "JUnit / Mockito",
  },
};

const PROJECTS = [
  {
    number: "01",
    title: "Wallet API - Billetera Virtual",
    description:
      "API RESTful para gestión de saldos y transferencias entre usuarios. Implementa autenticación stateless con JWT, encriptación de contraseñas con BCrypt, arquitectura en capas con DTOs, manejo global de excepciones y tests unitarios. Deployada en Render con MySQL en la nube.",
    link: "https://wallet-api-ysax.onrender.com/swagger-ui/index.html",
    github: "https://github.com/matisalinas7/wallet-api",
    image: "/wallet-api.png",
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.MYSQL, TAGS.JPA, TAGS.DOCKER, TAGS.JWT],
  },
  {
    number: "02",
    title: "API de Gestión de Reservas",
    description:
      "Desarrollo backend de una API REST para sistema de turnos. Construida con Spring Boot, integra seguridad RBAC (JWT), migraciones de base de datos (Flyway), testing (JUnit/Mockito) y documentación (Swagger). Lista para integración con frontend.",
    link: "",
    github: "https://github.com/matisalinas7/reservation-app",
    image: "/reservas.png",
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.MYSQL, TAGS.JWT, TAGS.SWAGGER],
  },
  {
    number: "03",
    title: "API REST para Gestión Gastronómica",
    description:
      "Arquitectura RESTful escalable. Implementa seguridad avanzada (RBAC) con JWT, arquitectura en capas, patrones de diseño y estrategias de integridad de datos (Soft Delete). Simulación de entorno de producción real.",
    link: "",
    github: "https://github.com/matisalinas7/elbuensabor-backend",
    image: "/codigo-backend.png",
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.MYSQL, TAGS.JPA, TAGS.JWT],
  },
  {
    number: "04",
    title: "Sistema Enterprise de Gestión de Trámites",
    description:
      "Aplicación corporativa desarrollada bajo un estricto enfoque de Desarrollo Dirigido por Modelos (MDD). Destaca por la fidelidad absoluta entre los Diagramas de Secuencia (Arquitectura) y la implementación del código Java.",
    link: "",
    github: "https://github.com/matisalinas7/gestionTramites",
    image: "/listaTramites.png",
    tags: [TAGS.JSF, TAGS.JAVA, TAGS.ARCHITECTURE, TAGS.MYSQL],
  },
];
---

<div class="flex flex-col">
  {
    PROJECTS.map(({ number, image, title, description, tags, link, github }) => (
      <article
        data-reveal
        class="group py-10 first:pt-0 last:pb-0 border-b border-line last:border-b-0"
      >
        {/* Captura */}
        <div class="rounded-xl overflow-hidden border border-line bg-surface">
          <div class="px-3.5 py-2 border-b border-line flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="size-2 rounded-full bg-line"></span>
              <span class="size-2 rounded-full bg-line"></span>
              <span class="size-2 rounded-full bg-line"></span>
            </div>
            <span class="text-[11px] font-mono text-subtle truncate max-w-[60%]">
              {title.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "")}
            </span>
            <span class="text-[11px] font-mono text-subtle">{number}</span>
          </div>

          <div class="relative overflow-hidden aspect-[16/10] bg-surface">
            <img
              alt={`Captura del proyecto ${title}`}
              class="object-cover object-top w-full h-full transition-transform duration-700 ease-out group-hover:scale-[1.025]"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        {/* Detalle */}
        <div class="mt-6 flex flex-col gap-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-fg text-balance">
            {title}
          </h3>

          <p class="text-[15px] sm:text-base text-muted leading-relaxed text-pretty max-w-2xl">
            {description}
          </p>

          <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologías utilizadas">
            {tags.map((tag) => (
              <li>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-mono border border-line text-muted">
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3 pt-2">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-full border border-line text-muted hover:border-fg/40 hover:text-fg transition-colors duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
              >
                <GitHub class="size-4" />
                <span>Code</span>
              </a>
            )}
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-full bg-fg text-bg hover:opacity-85 transition-opacity duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
              >
                <LiveAPI class="size-4" />
                <span>Live API</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
